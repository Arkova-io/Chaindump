# Copy to .env (never commit). In prod, load from GCP Secret Manager.
# Gemini is the default low-cost provider. In production the value comes from
# GCP Secret Manager: projects/arkova1/secrets/gemini-api-key.
DESK_PROVIDER=gemini
GEMINI_API_KEY=
# Set DESK_PROVIDER=claude before using this key; there is no silent fallback.
ANTHROPIC_API_KEY=
# Proposal-only credential for the Worker's durable review queue.
# Never put DESK_REVIEW_TOKEN in this agent environment: only a human reviewer
# may read pending work or promote/reject a proposal.
DESK_PROPOSAL_TOKEN=
# CHAINDUMP_BASE_URL=https://chaindump.xyz
# CHAINDUMP_MCP_URL=https://chaindump-mcp-270018525501.us-central1.run.app/mcp
# DESK_MODEL=gemini-2.5-flash-lite
# DESK_MAX_TURNS=6
# DESK_MAX_OUTPUT_TOKENS=4096
# Leave blank for the bounded cross-vertical review-debt pass.
# DESK_TASK=
